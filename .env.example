# YT Music Scrobbler - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED FOR MULTI-USER MODE (Optional for single-user/local)
# =============================================================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# =============================================================================
# OPTIONAL SECURITY
# =============================================================================

# Secret key for Flask sessions (auto-generated if not set)
SECRET_KEY=your-secret-key-here

# Required cron endpoint protection
CRON_SECRET=your-cron-secret

# =============================================================================
# NOTES
# =============================================================================
# 
# SINGLE-USER MODE (default):
# - No environment variables needed
# - Config stored in api/config.json
# - Scrobbles stored in api/scrobbled.json
# - Background sync uses local threading
#
# MULTI-USER MODE (when SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set):
# - Each user identified by Google OAuth
# - Credentials stored in Supabase database
# - Background sync via Vercel Cron (/api/cron)
# - Supports unlimited concurrent users
#
# For Vercel deployment:
# 1. Add these variables in Vercel Dashboard > Settings > Environment Variables
# 2. Configure cron-job.org to call /api/cron every 5 minutes with
#    Authorization: Bearer <CRON_SECRET>
